{
  "manifest_version": 3,
  "name": "Site Blocker",
  "version": "3.0",
  "description": "A minimal, privacy-first browser extension to block distracting websites, YouTube Shorts, Instagram Reels, and boost focus with a 1-click Distraction-Free mode and mindful breathing pause.",
  "browser_specific_settings": {
    "gecko": {
      "id": "site-blocker@extension",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["utils.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*",
        "*://*.facebook.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.reddit.com/*",
        "*://*.linkedin.com/*"
      ],
      "js": ["utils.js", "content_shorts.js"],
      "css": ["content_shorts.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js"],
      "matches": ["<all_urls>"]
    }
  ]
}